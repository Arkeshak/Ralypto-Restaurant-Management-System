# Ralypto Frontend Environment Configuration

# Backend API base URL (Used when VITE_USE_MOCKS=false)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend WebSocket URL for live kitchen & table updates (Used when VITE_USE_MOCKS=false)
VITE_WS_URL=ws://localhost:4000/ws

# Mock API Switch:
# - 'true':  Runs with in-browser Mock Service Worker (MSW) and mock data. No backend required.
# - 'false': Connects directly to the real backend via VITE_API_BASE_URL and VITE_WS_URL.
VITE_USE_MOCKS=true

# Application Display Title
VITE_APP_TITLE=Ralypto Restaurant OS
