# ==============================================================================
# Ralypto - Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local development.
# ==============================================================================

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://ralypto_user:ralypto_password@localhost:5432/ralypto_db?schema=public

# Cache & Pub/Sub (Redis 7)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=replace-with-a-random-32-byte-hex-string-for-access-token
JWT_REFRESH_SECRET=replace-with-a-random-32-byte-hex-string-for-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API (Backend AI processing only)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000/ws
VITE_USE_MOCKS=true
VITE_APP_TITLE=Ralypto Restaurant OS
